def FCBTrustedSpec.ExpectedType : Prop :=
∃ O > 0, ∃ O' > 0, ∀ᶠ (N : ℕ) in Filter.atTop, ↑(Erdos587.MaxNotSqSum N) ≤ O' * Real.nthRoot 3 ↑N * Real.log ↑N ^ O
def Erdos587.MaxNotSqSum : ℕ → ℕ :=
fun N => {A ∈ (Finset.Icc 1 N).powerset | ∀ S ⊆ A, S ≠ ⊥ → ¬IsSquare (∑ n ∈ S, n)}.sup Finset.card
