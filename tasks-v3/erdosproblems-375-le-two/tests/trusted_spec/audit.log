def FCBTrustedSpec.ExpectedType : Prop :=
∀ n ≥ 1,
  ∀ k ≤ 2,
    (∀ i < k, ¬Nat.Prime (n + i + 1)) → ∃ p, Function.Injective p ∧ ∀ (i : Fin k), Nat.Prime (p i) ∧ p i ∣ n + ↑i + 1
def Erdos375.Erdos375Prop : Prop :=
∀ n ≥ 1,
  ∀ (k : ℕ),
    (∀ i < k, ¬Nat.Prime (n + i + 1)) → ∃ p, Function.Injective p ∧ ∀ (i : Fin k), Nat.Prime (p i) ∧ p i ∣ n + ↑i + 1
