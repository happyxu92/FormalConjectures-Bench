def FCBTrustedSpec.ExpectedType : Prop :=
∀ {r : ℕ},
  3 ≤ r →
    ∃ c_r > 0,
      ∀ (k : ℕ) (A : Finset ℕ),
        Erdos535.AllBigOmega k A → Erdos535.NoConstantPairwiseGcdCoprimeSubsets r A → ↑A.card ≤ c_r ^ k * ↑k.factorial
'FCBTrustedSpec.ExpectedType' depends on axioms: [propext, Classical.choice, Quot.sound]
