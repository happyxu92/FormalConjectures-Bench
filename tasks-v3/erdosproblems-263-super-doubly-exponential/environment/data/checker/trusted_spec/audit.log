audited FCBTrustedSpec.ExpectedType: [propext, Quot.sound, Classical.choice]
audited Erdos263.IsIrrationalitySequence: [Quot.sound, propext, Classical.choice]
universe parameters: []
def FCBTrustedSpec.ExpectedType : Prop :=
∀ (a : ℕ → ℕ),
  (∀ (n : ℕ), a n > 0) →
    StrictMono a →
      (∃ ε > 0, Filter.liminf (fun n => ↑(a (n + 1)) / ↑(a n) ^ (2 + ε)) Filter.atTop > 0) →
        Erdos263.IsIrrationalitySequence a
'FCBTrustedSpec.ExpectedType' depends on axioms: [propext, Classical.choice, Quot.sound]
