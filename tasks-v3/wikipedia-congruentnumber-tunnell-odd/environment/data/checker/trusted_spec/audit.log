def FCBTrustedSpec.ExpectedType : Prop :=
∀ (n : ℕ),
  Squarefree n →
    Odd n → CongruentNumber.congruentNumber n → 2 * (CongruentNumber.A n).ncard = (CongruentNumber.B n).ncard
def CongruentNumber.congruentNumber : ℕ → Prop :=
fun n => ∃ a b c, a ^ 2 + b ^ 2 = c ^ 2 ∧ ↑n = 2⁻¹ * a * b
def CongruentNumber.A : ℕ → Set (ℤ × ℤ × ℤ) :=
fun n => {(x, y, z) | ↑n = 2 * x ^ 2 + y ^ 2 + 32 * z ^ 2}
def CongruentNumber.B : ℕ → Set (ℤ × ℤ × ℤ) :=
fun n => {(x, y, z) | ↑n = 2 * x ^ 2 + y ^ 2 + 8 * z ^ 2}
