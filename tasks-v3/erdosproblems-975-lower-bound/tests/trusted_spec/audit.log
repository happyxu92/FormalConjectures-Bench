  @Irreducible (@Polynomial Int Int.instSemiring)
      (@MonoidWithZero.toMonoid (@Polynomial Int Int.instSemiring)
        (@Semiring.toMonoidWithZero (@Polynomial Int Int.instSemiring) (@Polynomial.semiring Int Int.instSemiring)))
