audited ExpectedType transitive dependencies: [propext, Quot.sound, Classical.choice]
complete binder count: 2
universe parameters: []
def FCBTrustedSpec.ExpectedType : Prop :=
∀ (m : ℕ),
  0 < m →
    ∃ k > 0,
      ∃ n,
        n 0 = 1 ∧
          ∀ (i : ℕ) (hik : i < k),
            n ⟨i, ⋯⟩ < n ⟨i + 1, ⋯⟩ ∧
              (∀ i ∈ Finset.Icc 1 (Fin.last k),
                  ArithmeticFunction.cardDistinctFactors (n i) = 3 ∧ ArithmeticFunction.cardFactors (n i) = 3) ∧
                ↑m = ∑ i ∈ Finset.Icc 1 (Fin.last k), 1 / ↑(n i)
'FCBTrustedSpec.ExpectedType' depends on axioms: [propext, Classical.choice, Quot.sound]
