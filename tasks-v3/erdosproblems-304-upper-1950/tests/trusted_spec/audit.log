def Erdos304.unitFractionExpressible : ℕ → ℕ → Set ℕ :=
fun a b => {k | ∃ s, s.card = k ∧ (∀ n ∈ s, n > 1) ∧ ↑a / ↑b = ∑ n ∈ s, (↑n)⁻¹}
def Erdos304.smallestCollection : ℕ → ℕ → ℕ :=
fun a b => sInf (Erdos304.unitFractionExpressible a b)
def Erdos304.smallestCollectionTo : ℕ → ℕ :=
fun b => sSup {x | ∃ a ∈ Finset.Ico 1 b, Erdos304.smallestCollection a b = x}
