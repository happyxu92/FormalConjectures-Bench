def FCBTrustedSpec.ExpectedType : Prop :=
∃ c₃ > 0,
  ∃ c₄ > 0,
    ∃ t₀,
      ∀ᶠ (t : ℕ) in Filter.atTop,
        ∃ dₜ, (Erdos859.DivisorSumSet t).HasDensity dₜ ∧ 1 / Real.log ↑t ^ c₃ < dₜ ∧ dₜ < 1 / Real.log ↑t ^ c₄
def Erdos859.DivisorSumSet : ℕ → Set ℕ :=
fun t => {n | ∃ s ⊆ n.divisors, t = ∑ i ∈ s, i}
