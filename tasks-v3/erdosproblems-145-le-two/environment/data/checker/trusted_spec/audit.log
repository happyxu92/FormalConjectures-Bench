audited FCBTrustedSpec.ExpectedType: [propext, Quot.sound, Classical.choice]
audited Erdos145.s: [Classical.choice, propext, Quot.sound]
audited Erdos145.A: [propext, Quot.sound, Classical.choice]
complete binder count: 2
universe parameters: []
def FCBTrustedSpec.ExpectedType : Prop :=
∀ {α : ℝ},
  α ∈ Set.Icc 0 2 →
    ∃ β,
      Filter.Tendsto (fun x => 1 / x * ∑ n ∈ Erdos145.A x, (↑(Erdos145.s (n + 1)) - ↑(Erdos145.s n)) ^ α) Filter.atTop
        (nhds β)
'FCBTrustedSpec.ExpectedType' depends on axioms: [propext, Classical.choice, Quot.sound]
