def FCBTrustedSpec.ExpectedType : Prop :=
∃ k,
  (∀ᶠ (N : ℕ) in Filter.atTop, 1 ≤ k N ∧ k N ≤ N) ∧
    (fun N => ↑(k N)) =Θ[Filter.atTop] Green25.bestUpper ∧ ¬∀ᶠ (N : ℕ) in Filter.atTop, Green25.Property25 (k N) N
def Green25.Property25 : ℕ → ℕ → Prop :=
fun k N =>
  1 ≤ k ∧
    k ≤ N ∧
      ∀ (P : Finpartition (Finset.Icc 1 N)), P.parts.card = k → 10 * (P.parts.biUnion Finset.restrictedSumset).card ≥ N
def Green25.bestUpper : ℕ → ℝ :=
fun N => ↑N / Real.log ↑N
