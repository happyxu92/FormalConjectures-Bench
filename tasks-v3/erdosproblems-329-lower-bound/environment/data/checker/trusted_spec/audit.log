def FCBTrustedSpec.ExpectedType : Prop :=
∃ A, IsSidon A ∧ Erdos329.sidonUpperDensity A ≥ 1 / 2
def Erdos329.sqrtPartialDensity : Set ℕ → ℕ → ℝ :=
fun A N => ↑(A ∩ Set.Icc 1 N).ncard / √↑N
def Erdos329.sidonUpperDensity : Set ℕ → ℝ :=
fun A => Filter.limsup (fun N => Erdos329.sqrtPartialDensity A N) Filter.atTop
