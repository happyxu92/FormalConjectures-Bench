def FCBTrustedSpec.ExpectedType : Prop :=
∀ (ε : ℝ),
  0 < ε ∧ ε < 1 / Real.exp 1 →
    ∀ᶠ (p : ℕ) in Filter.atTop,
      Nat.Prime p →
        ∃ k,
          ∑ q ∈ Erdos786.consecutivePrimesFrom p k, 1 / ↑q < 1 ∧
            1 < ∑ q ∈ Erdos786.consecutivePrimesFrom p (k + 1), 1 / ↑q ∧
              {n | ∑ q ∈ Erdos786.consecutivePrimesFrom p k, n.factorization q = 1}.HasDensity (1 / Real.exp 1 - ε) ∧
                Erdos786.Set.IsMulCardSet {n | ∑ q ∈ Erdos786.consecutivePrimesFrom p k, n.factorization q = 1}
def Erdos786.Set.IsMulCardSet.{u_1} : {α : Type u_1} → [CommMonoid α] → Set α → Prop :=
fun {α} [CommMonoid α] A => ∀ (a b : Finset α), ↑a ⊆ A → ↑b ⊆ A → a.prod id = b.prod id → a.card = b.card
def Erdos786.consecutivePrimesFrom : ℕ → ℕ → Finset ℕ :=
fun p k => Finset.image (Nat.nth fun q => Nat.Prime q ∧ p ≤ q) (Finset.range (k + 1))
