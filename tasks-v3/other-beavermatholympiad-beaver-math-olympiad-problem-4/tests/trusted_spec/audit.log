audited ExpectedType transitive dependencies: [propext]
complete outer binders: [a, a_ini, a_rec]
universe parameters: []
def FCBTrustedSpec.ExpectedType : Prop :=
∀ (a : ℕ → ℕ),
  a 0 = 2 →
    (∀ (n : ℕ), a (n + 1) = if a n % 3 = 0 then a n / 3 + 2 ^ n + 1 else (a n - 2) / 3 + 2 ^ n - 1) → ¬∃ n, a n % 3 = 1
'FCBTrustedSpec.ExpectedType' depends on axioms: [propext]
