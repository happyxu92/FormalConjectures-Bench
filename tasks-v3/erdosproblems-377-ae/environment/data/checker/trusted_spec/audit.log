def FCBTrustedSpec.ExpectedType : Prop :=
∀ (γ₀ : ℝ),
  γ₀ = ∑' (k : ℕ), Real.log (↑k + 2) / 2 ^ (k + 2) →
    ∃ o,
      ∃ (_ : Filter.Tendsto o Filter.atTop (nhds 0)),
        ∀ᶠ (n : ℕ) in Filter.cofinite, Erdos377.sumInvPrimesNotDvdCentralBinom n = γ₀ + o n
@[reducible] def Erdos377.sumInvPrimesNotDvdCentralBinom : ℕ → ℝ :=
fun n => ∑ p ∈ Finset.Icc 1 n with Nat.Prime p, if p ∣ n.centralBinom then 0 else 1 / ↑p
