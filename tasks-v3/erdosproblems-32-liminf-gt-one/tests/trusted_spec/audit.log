audited FCBTrustedSpec.ExpectedType: [propext, Quot.sound, Classical.choice]
audited Erdos32.IsAdditiveComplementToPrimes: [propext, Quot.sound]
universe parameters: []
def FCBTrustedSpec.ExpectedType : Prop :=
∀ (A : Set ℕ),
  Erdos32.IsAdditiveComplementToPrimes A →
    1 < Filter.liminf (fun N => ↑{x ∈ Finset.Icc 1 N | x ∈ A}.card / ↑(Real.log ↑N)) Filter.atTop
'FCBTrustedSpec.ExpectedType' depends on axioms: [propext, Classical.choice, Quot.sound]
