audited FCBTrustedSpec.ExpectedType: [propext, Quot.sound, Classical.choice]
universe parameters: []
def FCBTrustedSpec.ExpectedType : Prop :=
∀ k ≥ 2, ∀ (n x l : ℕ), 2 ≤ l → ∏ x ∈ Finset.Ioc n (n + k), x ≠ x ^ l
'FCBTrustedSpec.ExpectedType' depends on axioms: [propext, Classical.choice, Quot.sound]
