audited FCBTrustedSpec.ExpectedType: [propext, Quot.sound, Classical.choice]
audited Erdos126.IsMaximalAddFactorsCard: [propext, Quot.sound, Classical.choice]
universe parameters: []
def FCBTrustedSpec.ExpectedType : Prop :=
∀ (f : ℕ → ℕ),
  Erdos126.IsMaximalAddFactorsCard f →
    ((fun n => Real.log ↑n) =O[Filter.atTop] fun n => ↑(f n)) ∧
