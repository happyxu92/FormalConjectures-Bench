complete outer binders: 2; ordered universes: []
def FCBTrustedSpec.ExpectedType : Prop :=
∀ (G : ℕ → ℕ),
  (G = fun x => (Finset.filter AgohGiuga.IsStrongGiuga (Finset.Icc 1 x)).card) →
    ∃ N O, ∀ n ≥ N, ↑(G n) ≤ O * √↑n * Real.log ↑n
def AgohGiuga.IsStrongGiuga : ℕ → Prop :=
fun n => n.Composite ∧ n ∣ 1 + ∑ i ∈ Finset.Ioo 0 n, i ^ (n - 1)
'FCBTrustedSpec.ExpectedType' depends on axioms: [propext, Classical.choice, Quot.sound]
'AgohGiuga.IsStrongGiuga' depends on axioms: [propext, Classical.choice, Quot.sound]
